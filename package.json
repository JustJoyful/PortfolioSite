    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
